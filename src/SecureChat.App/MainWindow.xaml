<Window
    x:Class="SecureChat.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SecureChat.App"
    xmlns:vm="using:SecureChat.App.ViewModels">

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="MineTemplate" x:DataType="vm:ChatMessage">
                <StackPanel MaxWidth="360" Margin="8,4" HorizontalAlignment="Right">
                    <TextBlock Text="{x:Bind Header}" FontSize="11" Opacity="0.55" HorizontalAlignment="Right"/>
                    <Border Background="#0B6AEB" CornerRadius="10,2,10,10" Padding="12,8">
                        <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" Foreground="White"
                                   FontSize="14" LineHeight="21"/>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="TheirsTemplate" x:DataType="vm:ChatMessage">
                <StackPanel MaxWidth="360" Margin="8,4" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Bind Header}" FontSize="11" Opacity="0.55" HorizontalAlignment="Left"/>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="2,10,10,10" Padding="12,8">
                        <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="SystemTemplate" x:DataType="vm:ChatMessage">
                <TextBlock Text="{x:Bind Content}" FontSize="12" Opacity="0.6"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           Margin="16,6" FontStyle="Italic"/>
            </DataTemplate>

            <!-- OVER 互动卡片:接收方选择挂断或继续聊,带入場动画 -->
            <DataTemplate x:Key="OverCardTemplate" x:DataType="vm:ChatMessage">
                <Border MaxWidth="340" Margin="8,6" HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16,12">
                    <Border.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="40"/>
                        </TransitionCollection>
                    </Border.Transitions>
                    <StackPanel Spacing="10">
                        <TextBlock Text="📻 OVER!要结束这次通话吗?" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="双方都同意才会挂断" FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="18,8"
                                    Click="OverAccept_Click" Content="OVER,拜拜 👋"/>
                            <Button Padding="18,8" Click="OverReject_Click" Content="不 over,继续聊"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <local:ChatTemplateSelector x:Key="ChatSelector"
                                        MineTemplate="{StaticResource MineTemplate}"
                                        TheirsTemplate="{StaticResource TheirsTemplate}"
                                        SystemTemplate="{StaticResource SystemTemplate}"
                                        OverCardTemplate="{StaticResource OverCardTemplate}"/>

            <!-- 发送按钮:与"我的气泡"同款蓝 -->
            <SolidColorBrush x:Key="SendAccentBrush" Color="#0B6AEB"/>
            <SolidColorBrush x:Key="SendAccentBrushHover" Color="#0958C4"/>

            <!-- OVER 按钮:电台挂断的橙红 -->
            <SolidColorBrush x:Key="OverBrush" Color="#E1462C"/>
            <SolidColorBrush x:Key="OverBrushHover" Color="#C93A22"/>

            <!-- 亮色实心按钮模板:Normal/Hover/Pressed 各用专属刷子,Disabled 整体降透明度 -->
            <Style x:Key="SolidButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{TemplateBinding Tag}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{TemplateBinding Tag}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SendAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SolidButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SendAccentBrush}"/>
                <Setter Property="Tag" Value="{StaticResource SendAccentBrushHover}"/>
            </Style>

            <Style x:Key="OverButtonStyle" TargetType="Button" BasedOn="{StaticResource SolidButtonStyle}">
                <Setter Property="Background" Value="{StaticResource OverBrush}"/>
                <Setter Property="Tag" Value="{StaticResource OverBrushHover}"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 连接配置区(房间码流程,500px 窄窗自适应:分行排布) ═══ -->
        <StackPanel Grid.Row="0" Padding="16,12,16,8" Spacing="8">
            <!-- 配置输入区:连接/等待期间锁定,防止中途改动 -->
            <ContentControl IsEnabled="{x:Bind Vm.CanConfigure, Mode=OneWay}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="SecureChat 安全通话" FontSize="17" FontWeight="SemiBold"/>
                    <!-- 第 1 行:角色 + 显示名 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="RoleCombo" SelectedIndex="{x:Bind Vm.ListenModeIndex, Mode=TwoWay}" MinWidth="160">
                            <ComboBoxItem Content="创建房间(等待加入)"/>
                            <ComboBoxItem Content="加入房间(粘贴码)"/>
                        </ComboBox>
                        <TextBox Text="{x:Bind Vm.DisplayName, Mode=TwoWay}" PlaceholderText="我的显示名"
                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinWidth="120"/>
                    </StackPanel>
                    <!-- 第 2 行:创建模式 = 本机 IP + 端口 + 换钥周期 -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ListenVisibility(Vm.IsListenMode), Mode=OneWay}">
                        <ComboBox ItemsSource="{x:Bind Vm.HostIps, Mode=OneWay}"
                                  SelectedItem="{x:Bind Vm.HostIp, Mode=TwoWay}"
                                  MinWidth="150" ToolTipService.ToolTip="本机对外 IP,多网卡时请选择对方可达的那个"/>
                        <TextBox Text="{x:Bind Vm.ListenPort, Mode=TwoWay}" PlaceholderText="端口" MinWidth="70"/>
                        <TextBox Text="{x:Bind Vm.RotationMinutes, Mode=TwoWay}" PlaceholderText="换钥(分钟)" MinWidth="90"/>
                    </StackPanel>
                    <!-- 第 2 行:加入模式 = 粘贴房间码(整行宽度自适应) -->
                    <TextBox Text="{x:Bind Vm.RoomCodeInput, Mode=TwoWay}" PlaceholderText="粘贴对方发来的房间码(SC1- 开头)"
                             Visibility="{x:Bind ConnectVisibility(Vm.IsListenMode), Mode=OneWay}"/>
                </StackPanel>
            </ContentControl>
            <!-- 创建模式:房间码展示 + 复制(在等待对方加入期间必须可用,故不在禁用区内);星号列随窗口伸缩 -->
            <Grid ColumnSpacing="8" Visibility="{x:Bind ListenVisibility(Vm.IsListenMode), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{x:Bind Vm.GeneratedCode, Mode=OneWay}" IsReadOnly="True"
                         PlaceholderText="点击&quot;创建房间&quot;后,这里会生成房间码"
                         FontFamily="Consolas" FontSize="12"
                         IsEnabled="{x:Bind CanCopyCode(Vm.GeneratedCode), Mode=OneWay}"/>
                <Button Grid.Column="1" Click="CopyCode_Click" Padding="12,6"
                        IsEnabled="{x:Bind CanCopyCode(Vm.GeneratedCode), Mode=OneWay}"
                        ToolTipService.ToolTip="复制房间码发给对方">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="复制房间码"/>
                    </StackPanel>
                </Button>
            </Grid>
            <!-- 操作按钮 + 状态文字独立成行,窄窗不挤压。
                 会话操作槽位:连接中 = OVER(橙红,双方确认挂断);等待对方/握手中 = 取消等待。 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                        Command="{x:Bind Vm.CreateRoomCommand}"
                        IsEnabled="{x:Bind Vm.CanConfigure, Mode=OneWay}"
                        Visibility="{x:Bind ListenVisibility(Vm.IsListenMode), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F1;" FontSize="14"/>
                        <TextBlock Text="创建房间"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                        Command="{x:Bind Vm.JoinRoomCommand}"
                        IsEnabled="{x:Bind Vm.CanConfigure, Mode=OneWay}"
                        Visibility="{x:Bind ConnectVisibility(Vm.IsListenMode), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72E;" FontSize="14"/>
                        <TextBlock Text="加入房间"/>
                    </StackPanel>
                </Button>
                <!-- OVER(空闲):发起挂断协商 -->
                <Button Style="{StaticResource OverButtonStyle}" Command="{x:Bind Vm.SendOverCommand}"
                        Padding="14,5" MinWidth="90"
                        IsEnabled="{x:Bind Vm.CanChat, Mode=OneWay}"
                        ToolTipService.ToolTip="向对方发出 OVER 请求,双方同意才挂断"
                        Visibility="{x:Bind VisibleIf(Vm.IsOverIdleAndConnected), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE717;" FontSize="14"/>
                        <TextBlock Text="OVER"/>
                    </StackPanel>
                </Button>
                <!-- OVER(已发出):脉冲等待 + 撤回 -->
                <StackPanel Orientation="Horizontal" Spacing="4"
                            Visibility="{x:Bind VisibleIf(Vm.IsOverWaiting), Mode=OneWay}">
                    <TextBlock x:Name="OverWaitText" Text="OVER 已发出…" VerticalAlignment="Center" FontSize="12"/>
                    <Button Click="CancelOver_Click" Padding="8,4" Content="撤回"
                            ToolTipService.ToolTip="撤回 OVER 请求,继续聊天"/>
                </StackPanel>
                <!-- 等待对方加入/握手中:取消(复用断开命令) -->
                <Button Command="{x:Bind Vm.DisconnectCommand}" MinWidth="90"
                        IsEnabled="{x:Bind Vm.CanDisconnect, Mode=OneWay}"
                        Visibility="{x:Bind VisibleIf(Vm.IsBusy), Mode=OneWay}"
                        Content="取消等待"/>
            </StackPanel>
            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" Opacity="0.85" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"/>

        <!-- ═══ 聊天区 ═══ -->
        <Grid Grid.Row="1" Padding="8,4,8,4">
            <ListView x:Name="ChatList"
                      ItemsSource="{x:Bind Vm.Messages, Mode=OneWay}"
                      ItemTemplateSelector="{StaticResource ChatSelector}"
                      SelectionMode="None"/>
        </Grid>

        <!-- ═══ 输入区 ═══ -->
        <ContentControl Grid.Row="2" IsEnabled="{x:Bind Vm.CanChat, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid Padding="12,4,12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0"
                         Text="{x:Bind Vm.InputText, Mode=TwoWay}"
                         PlaceholderText="输入消息,回车发送(传输前自动加密)"
                         KeyDown="InputBox_KeyDown"/>
                <!-- 发送:与"我的气泡"同款蓝,蓝色按钮发出蓝色气泡 -->
                <Button Grid.Column="1" Command="{x:Bind Vm.SendCommand}" MinWidth="84"
                        Style="{StaticResource SendAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;" FontSize="14"/>
                        <TextBlock Text="发送"/>
                    </StackPanel>
                </Button>
            </Grid>
        </ContentControl>

        <!-- ═══ 密钥状态区 ═══ -->
        <Grid Grid.Row="3" Padding="16,6,16,10" ColumnSpacing="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind Vm.KeyInfo, Mode=OneWay}"
                       FontSize="12" Opacity="0.8" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Command="{x:Bind Vm.RekeyNowCommand}"
                    IsEnabled="{x:Bind Vm.IsConnected, Mode=OneWay}" Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D7;" FontSize="14"/>
                    <TextBlock Text="立即换钥"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
